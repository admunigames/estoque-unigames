{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "pnpm build && node --test --experimental-strip-types tests/rendered-html.test.mjs tests/finance-payables.test.mjs tests/finance-cash-flow.test.mjs tests/finance-card-machines.test.mjs tests/finance-card-fees.test.mjs tests/finance-corporate-cards.test.mjs tests/finance-bank-reconciliation.test.mjs tests/finance-fase8-itens-diversos.test.mjs tests/hr-benefits.test.mjs tests/hr-working-days.test.mjs tests/hr-payroll.test.mjs tests/finance-rateio.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate-data": "node db/scripts/migrate-d1-to-supabase.mjs",
    "deploy": "vinext build && wrangler deploy -c wrangler.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "postgres": "3.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
